FROM node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66 AS node

FROM ghcr.io/open-webui/open-terminal:0.14.0-slim@sha256:ba7a67129bbaf8618887eb6283d7e351275e2838c0751bbafebbce6b22938687

USER root

# The slim upstream image intentionally has no sudo. Add the tools exercised by
# this stack at build time instead of allowing package installation at runtime.
# Node.js LTS comes from the official image: Debian's nodejs/npm packages are
# the upstream-EOL Node 20 and bundle npm dependencies with unfixed
# High/Critical advisories.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

# npm 11.21.1 updates bundled brace-expansion, undici and http-cache-semantics
# (CVE-2026-102276, CVE-2026-102278, CVE-2026-19534, CVE-2026-93748).
# Then apply Debian security updates published after the upstream image was built.
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global --no-audit --no-fund npm@11.21.1 \
    && rm -rf /root/.npm \
    && node --version && npm --version \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/user/.cache /home/user/.config /home/user/.local/state/open-terminal \
    && chown -R 1000:1000 /home/user

ENV HOME=/home/user \
    XDG_CACHE_HOME=/home/user/.cache \
    XDG_CONFIG_HOME=/home/user/.config \
    XDG_STATE_HOME=/home/user/.local/state \
    OPEN_TERMINAL_LOG_DIR=/home/user/.local/state/open-terminal

WORKDIR /home/user
USER 1000:1000

# The ENTRYPOINT below bypasses the upstream entrypoint and so hardcodes paths
# the base image is not contractually obliged to keep. Assert them here so a
# base-image change fails the build instead of crash-looping the container.
RUN test -x /usr/bin/tini && command -v open-terminal >/dev/null

# Do not use the upstream slim entrypoint: it deliberately starts as root to
# chown volumes and optionally configure iptables before invoking gosu.
ENTRYPOINT ["/usr/bin/tini", "--", "open-terminal"]
CMD ["run"]
