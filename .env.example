# Required secret. Generate a value with: openssl rand -hex 32
VLLM_API_KEY=replace-with-a-random-api-key

# Optional model and listener settings.
MODEL_PRESET=Qwen3.6-35B-A3B
HOST_PORT=8000
VLLM_BIND_ADDRESS=127.0.0.1
VLLM_SHM_SIZE=8gb
# Optional override; scripts default to $HOME/.cache/huggingface.
# HF_CACHE_PATH=/absolute/path/to/huggingface

# Optional runtime settings.
MAX_MODEL_LEN=
GPU_MEMORY_UTILIZATION=
MAX_NUM_SEQS=
MAX_NUM_BATCHED_TOKENS=
