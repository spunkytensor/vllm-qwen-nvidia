# Required secrets. Generate independent values with: openssl rand -hex 32
VLLM_API_KEY=replace-me
WEBUI_SECRET_KEY=replace-me
OPEN_TERMINAL_API_KEY=replace-me
TAVILY_API_KEY=replace-me

# Optional model and listener settings.
MODEL_PRESET=Qwen3.6-35B-A3B
HOST_PORT=8000
OPEN_WEBUI_PORT=3000
VLLM_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
VLLM_SHM_SIZE=8gb
# Optional override; scripts default to $HOME/.cache/huggingface.
# HF_CACHE_PATH=/absolute/path/to/huggingface
# Optional override; scripts default to $HOME/.cache/open-webui/embedding.
# EMBEDDING_CACHE_PATH=/absolute/path/to/embedding-cache

# Optional runtime settings.
OPEN_TERMINAL_MAX_SESSIONS=8
MAX_MODEL_LEN=
GPU_MEMORY_UTILIZATION=
MAX_NUM_SEQS=
MAX_NUM_BATCHED_TOKENS=
