FROM ghcr.io/open-webui/open-webui:v0.12.3@sha256:a537bbe1e6b428820f52ed4a029d7fff97062e24d5cf32c365fba36fd0542def

USER root

# Apply Debian security updates published after the upstream image was built,
# then patch Python packages with known High/Critical advisories.
COPY docker/open-webui/requirements.txt /tmp/security-requirements.txt
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --disable-pip-version-check -r /tmp/security-requirements.txt \
    && pip check \
    && rm /tmp/security-requirements.txt

RUN groupadd --gid 10001 openwebui \
    && useradd --no-log-init --uid 10001 --gid 10001 \
      --home-dir /app/backend/data/home --no-create-home --shell /usr/sbin/nologin openwebui \
    && mkdir -p /app/backend/data/home \
    && chown -R 10001:10001 /app/backend/data /app/backend/open_webui/static

ENV HOME=/app/backend/data/home \
    XDG_CACHE_HOME=/app/backend/data/cache \
    XDG_CONFIG_HOME=/app/backend/data/home/.config

USER 10001:10001
